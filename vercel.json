{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "drajoyceradis.vercel.app"
        }
      ],
      "destination": "/outubro-rosa/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "drajoyceradis.com"
        }
      ],
      "destination": "/inicio/index.html"
    }
  ]
}
